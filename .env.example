APP_NAME=PackageProof Pro
ENVIRONMENT=production
DATABASE_URL=sqlite:////app/data/packageproof.db

# OKX x402 payment
X402_ENABLED=true
NETWORK=eip155:196
PAY_TO_ADDRESS=0xYOUR_SETTLEMENT_ADDRESS
OKX_API_KEY=your_okx_api_key
OKX_SECRET_KEY=your_okx_secret_key
OKX_PASSPHRASE=your_okx_passphrase
OKX_BASE_URL=https://web3.okx.com
ANALYZE_PACKAGE_PRICE=$0.05

# Optional demo mode: comma-separated wallet addresses that may sign the x402
# challenge and receive access without settlement. Empty defaults to the owner
# demo wallet; set to "none" to disable exemptions for fully paid production.
X402_EXEMPT_PAYERS=

# E2B sandbox
ENABLE_E2B=true
E2B_API_KEY=e2b_YOUR_KEY
E2B_ALLOW_INTERNET_ACCESS=true
E2B_INSTALL_STRACE=true
E2B_TEMPLATE=
E2B_TIMEOUT_SECONDS=90

# OpenRouter analyst summaries
OPENROUTER_API_KEY=sk-or-v1-YOUR_KEY
OPENROUTER_MODEL=openai/gpt-4.1-mini

# Runtime tuning
CACHE_TTL_SECONDS=86400
HTTP_TIMEOUT_SECONDS=15
MAX_ARCHIVE_BYTES=8388608
MAX_STATIC_FILES=250
