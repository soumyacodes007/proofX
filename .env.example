APP_NAME=PackageProof Pro
ENVIRONMENT=development
DATABASE_URL=sqlite:///./data/packageproof.db

# OKX x402 payment
X402_ENABLED=false
NETWORK=eip155:196
PAY_TO_ADDRESS=
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
OKX_BASE_URL=https://web3.okx.com
ANALYZE_PACKAGE_PRICE=$0.05

# Optional scanners
E2B_API_KEY=
ENABLE_E2B=false
E2B_ALLOW_INTERNET_ACCESS=true
E2B_INSTALL_STRACE=true
E2B_TEMPLATE=
E2B_TIMEOUT_SECONDS=90

# Optional AI analyst
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
